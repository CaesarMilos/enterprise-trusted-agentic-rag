# 中文：本文件只提供本地开发示例，生产环境必须通过密钥管理系统注入凭据。
# English: This file is for local development; production secrets must come from secret storage.
ENTERPRISE_RAG_ENV=development
ENTERPRISE_RAG_API_URL=http://127.0.0.1:8000/api/v1
LLM_API_KEY=ollama
EMBEDDING_API_KEY=

# 中文：开发配置固定使用 Demo 认证并仅绑定 127.0.0.1。
# English: Development explicitly uses demo auth and binds only to 127.0.0.1.
ENTERPRISE_RAG__SECURITY__AUTHENTICATION_MODE=demo
ENTERPRISE_RAG__SECURITY__DEMO_AUTH_ENABLED=true
ENTERPRISE_RAG__SECURITY__TRUSTED_PROXY_AUTH_ENABLED=false
ENTERPRISE_RAG__SECURITY__DEFAULT_TENANT_ID=demo-tenant

# 中文：LLM 只复核动态评分模糊区；关闭后仍执行结构、语义和长度评分。
# English: The LLM reviews only ambiguous score bands; deterministic scoring remains active.
ENTERPRISE_RAG__INGESTION__LLM_BOUNDARY_ENABLED=false
ENTERPRISE_RAG__INGESTION__LLM_BOUNDARY_MAX_CALLS=8
ENTERPRISE_RAG__OCR__ENABLED=false
ENTERPRISE_RAG__INGESTION__JOB_LEASE_SECONDS=300
ENTERPRISE_RAG__INGESTION__JOB_HEARTBEAT_SECONDS=60

# 中文：V5.1 源工程使用正文优先的双通道索引文本，并在发布前阻断有害重复向量。
# English: The V5.1 source tree uses body-first dual index text and blocks harmful vector collapse.
ENTERPRISE_RAG__INGESTION__EMBEDDING_TEXT_MAX_TOKENS=384
ENTERPRISE_RAG__INGESTION__INDEX_HEADING_MAX_DEPTH=2
ENTERPRISE_RAG__INGESTION__INDEX_HEADING_MAX_CHARACTERS=96
ENTERPRISE_RAG__INGESTION__MAX_EXACT_DUPLICATE_VECTOR_GROUP=3
ENTERPRISE_RAG__INGESTION__MAX_HARMFUL_DUPLICATE_VECTOR_RATIO=0.01

# 中文：生产 JWT 示例变量不得提交真实值。
# English: Never commit a real value for the production JWT secret example.
ENTERPRISE_RAG_JWT_SECRET=
