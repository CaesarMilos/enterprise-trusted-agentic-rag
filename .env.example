# 中文：本地开发环境示例；复制为 .env 后再按部署环境调整。
# English: Local development example; copy to .env and adjust for your deployment.
ENTERPRISE_RAG_ENV=development
LLM_API_KEY=ollama
EMBEDDING_API_KEY=

# 中文：双下划线把环境变量映射到嵌套 Settings 字段。
# English: Double underscores map environment variables to nested Settings fields.
ENTERPRISE_RAG__SECURITY__DEMO_AUTH_ENABLED=true
ENTERPRISE_RAG__SECURITY__DEFAULT_TENANT_ID=demo-tenant
# 中文：仅在模糊切点调用已配置的 LLM；关闭时仍使用结构和向量自适应切块。
# English: Invoke the configured LLM only for ambiguous cuts; structure and embeddings remain.
ENTERPRISE_RAG__INGESTION__LLM_BOUNDARY_ENABLED=true
# 中文：限制每份文档的 LLM 边界复核次数，控制接入成本和耗时。
# English: Bound LLM boundary reviews per document to control ingestion cost and latency.
ENTERPRISE_RAG__INGESTION__LLM_BOUNDARY_MAX_CALLS=8
# 中文：长时间 OCR、Embedding 和索引构建期间的任务租约与心跳间隔。
# English: Job lease and heartbeat intervals during OCR, embedding, and index construction.
ENTERPRISE_RAG__INGESTION__JOB_LEASE_SECONDS=300
ENTERPRISE_RAG__INGESTION__JOB_HEARTBEAT_SECONDS=60
# 中文：在 multipart 解析前限制完整 HTTP 请求体，并为表单封装保留余量。
# English: Limit the full body before multipart parsing and reserve form-encoding overhead.
ENTERPRISE_RAG__INGESTION__MAX_REQUEST_BODY_SIZE_MB=55
# 中文：生产环境可由可信反向代理注入身份头，并用共享密钥防止直接伪造。
# English: Production may trust proxy-injected identity headers protected by a shared secret.
ENTERPRISE_RAG__SECURITY__TRUSTED_PROXY_AUTH_ENABLED=false
ENTERPRISE_RAG_PROXY_SECRET=
# 中文：安装 `[ocr]` 可选依赖和系统 Tesseract 后即可自动补齐扫描页。
# English: Install the `[ocr]` extra and system Tesseract to complete scanned pages.
ENTERPRISE_RAG__OCR__ENABLED=false
